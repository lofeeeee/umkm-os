# Reverse proxy (PRD.md §9.1, §9.7).
# ROOT_DOMAIN: produksi = ryasai.my.id (ADR-0001), lokal = localhost.
# TLS produksi (wildcard *.ROOT_DOMAIN via DNS-01) MENUNGGU provider DNS; sampai itu
# semua site HTTP-only dan TIDAK boleh dipakai untuk trafik produksi.
{
	auto_https off
	admin localhost:2019
}

(hardening) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Upload gambar maks 2 MiB (ADR-0009) + overhead; API menegakkan batas persisnya.
	request_body {
		max_size 3MB
	}
}

http://api.{$ROOT_DOMAIN} {
	import hardening
	reverse_proxy api:8080
}

# Dashboard, marketing, dan tenant website: kontrak frontend contingent ADR-0014.
# Tidak ada aset/endpoint publik yang direkayasa sebelum ADR itu DISETUJUI.
http://{$ROOT_DOMAIN}, http://app.{$ROOT_DOMAIN}, http://*.{$ROOT_DOMAIN} {
	import hardening
	respond "Frontend belum tersedia (ADR-0014 MENUNGGU)" 503
}
