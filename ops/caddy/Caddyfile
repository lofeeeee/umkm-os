# Reverse proxy (PRD.md §9.1, §9.7).
# ROOT_DOMAIN: produksi = ryasai.my.id (ADR-0001), lokal = localhost.
# TLS produksi (wildcard *.ROOT_DOMAIN via DNS-01) MENUNGGU provider DNS; sampai itu
# semua site HTTP-only dan TIDAK boleh dipakai untuk trafik produksi.
{
	auto_https off
	admin localhost:2019
}

(hardening) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Upload gambar maks 2 MiB (ADR-0009) + overhead; API menegakkan batas persisnya.
	request_body {
		max_size 3MB
	}
}

http://api.{$ROOT_DOMAIN} {
	import hardening
	reverse_proxy api:8080
}

# CSP dengan hash skrip inline hasil build frontend (frontend/scripts/csp.mjs).
import /srv/www/csp.caddy

(static_cache) {
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html not path /_next/static/*
	header @html Cache-Control "no-cache"
}

# ADR-0014: dashboard = build statis; data dari api.{$ROOT_DOMAIN} (cookie + CSRF, ADR-0015).
http://app.{$ROOT_DOMAIN} {
	import hardening
	import csp_app
	import static_cache
	header X-Frame-Options DENY
	root * /srv/www
	# Renderer situs tenant tidak dilayani di host dashboard.
	@site path /site /site.html /site.txt
	respond @site 404
	try_files {path} {path}.html /404.html
	file_server
}

# Marketing belum dalam lingkup Phase 2: arahkan ke dashboard.
http://{$ROOT_DOMAIN} {
	import hardening
	redir http://app.{$ROOT_DOMAIN}{uri} 302
}

# ADR-0014: situs tenant. Tenant ditentukan API dari Host asli (P1-4); Caddy HANYA
# meneruskan /_api/public/* ke /api/v1/public/* tanpa mengubah Host. Path lain = shell statis.
http://*.{$ROOT_DOMAIN} {
	import hardening
	import csp_site
	import static_cache
	header X-Frame-Options DENY
	# Akun customer toko (ADR-0005): cookie host-only __Host-umkm_cust milik subdomain ini
	# diteruskan HANYA untuk endpoint akun customer & checkout. Cookie sesi staf host-only di
	# api.{$ROOT_DOMAIN} (ADR-0015) tidak pernah dikirim browser ke host toko.
	# Web chat (ADR-0006, P6-2): cookie sesi chat host-only __Host-umkm_chat juga hanya untuk /_api/public/chat/*.
	@customer path /_api/public/customer/* /_api/public/checkout /_api/public/chat/*
	handle @customer {
		uri replace /_api/public/ /api/v1/public/ 1
		reverse_proxy api:8080
	}
	handle /_api/public/* {
		uri replace /_api/public/ /api/v1/public/ 1
		reverse_proxy api:8080 {
			# Endpoint publik lain tidak memakai cookie (cache publik per Host).
			header_up -Cookie
		}
	}
	handle /_next/* {
		root * /srv/www
		file_server
	}
	# Aset publik frontend/public (mis. /theme-boot.js) yang BENAR-BENAR ada. Hanya ekstensi aset; halaman
	# HTML dashboard tidak pernah disajikan di host toko. Tanpa ini /theme-boot.js dijawab site.html (text/html)
	# dan browser menolak menjalankannya (strict MIME).
	@asset {
		path_regexp \.(js|css|png|jpe?g|svg|ico|webp|avif|woff2?)$
		file {
			root /srv/www
		}
	}
	handle @asset {
		root * /srv/www
		file_server
	}
	# ADR-0018: robots.txt & sitemap.xml per toko dari API (tenant dari Host asli).
	@seo path /robots.txt /sitemap.xml
	handle @seo {
		rewrite * /api/v1/public{path}
		reverse_proxy api:8080 {
			header_up -Cookie
		}
	}
	# ADR-0018: permintaan dokumen (path tanpa ekstensi file) → shell + <head> per toko dari API.
	# API gagal/nonaktif (4xx/5xx) → shell statis seperti sebelumnya: situs tetap tampil, hanya tanpa meta.
	@doc {
		method GET HEAD
		not path /_next/* /_api/*
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @doc {
		rewrite * /api/v1/public/document?path={path}
		reverse_proxy api:8080 {
			header_up -Cookie
			import web_shell
			@fail status 4xx 5xx
			handle_response @fail {
				root * /srv/www
				rewrite * /site.html
				file_server
			}
		}
	}
	handle {
		root * /srv/www
		rewrite * /site.html
		file_server
	}
}
