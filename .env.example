# Salin ke .env (di-gitignore) dan isi nilai nyata. Jangan commit .env.
# Semua variabel bertanda wajib: `docker compose` gagal bila kosong (fail-closed).

# development | staging | production. Production menolak start sampai D-01 DISETUJUI.
UMKM_ENV=staging
# Lokal: localhost (api.localhost). Produksi: ryasai.my.id (ADR-0001).
ROOT_DOMAIN=localhost

POSTGRES_USER=umkm_owner
POSTGRES_DB=umkm
POSTGRES_PASSWORD=change-me-local-only
# Password login aplikasi umkm_app (tanpa BYPASSRLS); berbeda dari owner.
APP_DB_PASSWORD=change-me-local-only-app
REDIS_PASSWORD=change-me-local-only
# Kunci HMAC signed URL file (ADR-0009), >= 32 byte: openssl rand -base64 48
FILE_SIGNING_KEY=change-me-local-only-file-signing-key-000000

# Opsional
CADDY_HTTP_PORT=80
RUST_LOG=info

# Backup (profile `backup`, ops/backup). Public key age dari `age-keygen -y`; private key disimpan DI LUAR server.
BACKUP_AGE_RECIPIENT=
# Perintah salin ke luar VPS (menunggu D-07). Kosong -> backup exit 3 (belum aman).
BACKUP_OFFSITE_CMD=
